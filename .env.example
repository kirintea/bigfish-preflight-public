# 本地配置示例：复制为 .env 后填写；不要提交真实密钥。
# Local configuration: use as .env and fill in your values; never commit real secrets.
# main_all.py 读取 .env，已有进程环境变量优先；main.py / tools.dev_server 不读取 .env。
# main_all.py loads .env without overriding process variables; main.py / tools.dev_server do not.

# 配置管理器的默认环境；显式配置路径优先，启动器默认使用 configs/test.yaml。
# Default environment for ConfigManager; explicit config paths take precedence; the launcher uses configs/test.yaml.
APP_ENV=dev

# 模型服务密钥；仅真实模型模式需要。不要将真实密钥写入本示例。
# Model service API key; required only for real-model mode. Keep real keys out of this example.
LLM_API_KEY=

# 替换为实际 OpenAI 兼容服务的基础地址，包含服务要求的版本路径，不含 /chat/completions。
# Replace with your OpenAI-compatible base URL, including its required version path, without /chat/completions.
LLM_BASE_URL=https://api.example.com/v1

# 模型标识须与所配置服务一致；以下为示例，可替换为服务支持的其他模型。
# Use the exact model ID supported by your configured service; the value below is an example.
LLM_MODEL_NAME=qwen3.7-flash-2026-07-15

# NPC LAB 管理凭据；此值仅用于本机开发，部署时更换为随机值。
# NPC LAB management token; this value is for local development only; use a random value for deployment.
TEST_ADMIN_TOKEN=local-npc-lab

# 本机 Collector 的 OTLP gRPC 接收地址；对应 docker/docker-compose.yml 的 4317 端口。
# Local Collector OTLP gRPC endpoint; matches port 4317 in docker/docker-compose.yml.
BIGFISH_OTLP_ENDPOINT=http://127.0.0.1:4317

# 可选项 / Optional settings
# 消息 Formatter 默认 openai；自定义兼容接口通常保持默认。
# Message Formatter defaults to openai; custom compatible endpoints usually keep the default.
# LLM_PROVIDER=openai

# 默认离线；使用 main_all.py --real-agent 或显式设为 false 才调用真实模型。
# Offline by default; use main_all.py --real-agent or explicitly set false to call a real model.
# BIGFISH_OFFLINE_MODE=true

# test/dev 配置默认导出链路；没有启动 Collector/Jaeger 时设为 false。
# test/dev configurations export traces by default; set false when Collector/Jaeger is not running.
# BIGFISH_OTLP_ENABLED=true

# 仅正式模拟来源接口需要；必须与管理凭据不同，并在 YAML 中配置世界与来源范围。
# Only needed for formal simulator APIs; must differ from the admin token and needs world/source scopes in YAML.
# SIMULATOR_TOKEN=
